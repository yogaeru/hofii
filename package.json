{
  "name": "hofii",
  "description": "An orchestration tools for manage dotfiles and packages",
  "type": "module",
  "bin": {
    "hofii": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx index.ts",
    "scan": "tsx index.ts scan",
    "validate": "tsx index.ts validate",
    "switch": "tsx index.ts switch",
    "build": "tsc --noEmit && esbuild index.ts --bundle --platform=node --format=esm --external:execa --outfile=dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cac": "^7.0.0",
    "deepmerge-ts": "^8.0.2",
    "execa": "^9.5.2",
    "smol-toml": "^1.3.1",
    "valibot": "^1.4.2"
  }
}
